  lineTotalCents           BigInt     @map("line_total_cents") @db.BigInt
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  refReservationIdEventId  Reserva @relation("rel_reserva_detalles_reservation_id_event_id_fkey", fields: [reservationId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: NoAction)
  refTicketTypeIdEventId   TipoTicket @relation("rel_reserva_detalles_ticket_type_id_event_id_fkey", fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: NoAction)
  @@unique([reservationId, ticketTypeId], map: "reserva_detalles_reservation_id_ticket_type_id_key")
  @@index([ticketTypeId], map: "reserva_detalles_ticket_type_idx")
