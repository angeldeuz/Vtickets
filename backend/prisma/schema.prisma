  @@schema("tickets_app")
}

model Pago {
  id                       String     @id(map: "pagos_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId               String     @map("purchase_id") @db.Uuid
  provider                 String     @db.Text
  externalPaymentId        String?    @map("external_payment_id") @db.Text
  status                   String     @default("created") @db.Text
  amountCents              BigInt     @map("amount_cents") @db.BigInt
  currency                 String     @default("MXN") @db.Text
  isTest                   Boolean    @map("is_test") @default(true)
  isExtraCharge            Boolean    @map("is_extra_charge") @default(false)
  verifiedAt               DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  refPurchaseId            Compra @relation("rel_pagos_purchase_id_fkey", fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fromReembolsoPaymentIdPurchaseId Reembolso[] @relation("rel_reembolsos_payment_id_purchase_id_fkey")
  fromTicketPaymentIdPurchaseId Ticket[] @relation("rel_tickets_payment_id_purchase_id_fkey")
  fromWebhookEventoPaymentId WebhookEvento[] @relation("rel_webhook_eventos_payment_id_fkey")
  @@unique([id, purchaseId], map: "pagos_id_purchase_id_key")
  @@unique([provider, externalPaymentId], map: "pagos_provider_external_payment_id_key")
  @@index([purchaseId, createdAt(sort: Desc)], map: "pagos_purchase_created_idx")
  @@map("pagos")
  @@schema("tickets_app")
}

model PersonalEvento {
  id                       String     @id(map: "event_staff_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String     @map("event_id") @db.Uuid
  userId                   String     @map("user_id") @db.Uuid
  roleId                   String     @map("role_id") @db.Uuid
  status                   String     @default("assigned") @db.Text
  assignedBy               String?    @map("assigned_by") @db.Uuid
  assignedAt               DateTime   @map("assigned_at") @default(now()) @db.Timestamptz(6)
  startsAt                 DateTime?  @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime?  @map("ends_at") @db.Timestamptz(6)
  refEventId               Evento @relation("rel_event_staff_event_id_fkey", fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refRoleId                Rol @relation("rel_event_staff_role_id_fkey", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refAssignedBy            Usuario? @relation("rel_personal_eventos_assigned_by_fkey", fields: [assignedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  refUserId                Usuario @relation("rel_personal_eventos_user_id_fkey", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
