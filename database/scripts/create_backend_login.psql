\set ON_ERROR_STOP on
-- Ejecutar con una conexión administrativa en un entorno nuevo.
-- La contraseña se solicita de forma interactiva y nunca se versiona.
\prompt -hide 'Contraseña nueva de tickets_app_login: ' runtime_password

SELECT format(
  'CREATE ROLE tickets_app_login LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
  :'runtime_password'
)
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'tickets_app_login')
\gexec

GRANT tickets_app_runtime TO tickets_app_login;
\unset runtime_password
