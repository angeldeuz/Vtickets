  @@schema("tickets_app")
}

model Ticket {
  id                       String     @id(map: "tickets_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId               String     @map("purchase_id") @db.Uuid
  purchaseDetailId         String     @map("purchase_detail_id") @db.Uuid
  paymentId                String     @map("payment_id") @db.Uuid
  ordinal                  Int        @db.Integer
  publicCode               String     @map("public_code") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credentialVersion        Int        @map("credential_version") @default(1) @db.SmallInt
  credentialKeyId          String?    @map("credential_key_id") @db.Text
  status                   String     @default("issued") @db.Text
  issuedAt                 DateTime   @map("issued_at") @default(now()) @db.Timestamptz(6)
  refPaymentIdPurchaseId   Pago @relation("rel_tickets_payment_id_purchase_id_fkey", fields: [paymentId, purchaseId], references: [id, purchaseId], onDelete: Restrict, onUpdate: NoAction)
  refPurchaseDetailIdPurchaseId CompraDetalle @relation("rel_tickets_purchase_detail_id_purchase_id_fkey", fields: [purchaseDetailId, purchaseId], references: [id, purchaseId], onDelete: Restrict, onUpdate: NoAction)
  fromAccesoTicketId       Acceso? @relation("rel_accesos_ticket_id_fkey")
  fromHistorialEscaneoTicketId HistorialEscaneo[] @relation("rel_historial_escaneos_ticket_id_fkey")
  fromReembolsoTicketIdPurchaseId Reembolso? @relation("rel_reembolsos_ticket_id_purchase_id_fkey")
  @@unique([id, publicCode], map: "tickets_id_public_code_key")
  @@unique([id, purchaseId], map: "tickets_id_purchase_id_key")
  @@unique([publicCode], map: "tickets_public_code_key")
  @@unique([purchaseDetailId, ordinal], map: "tickets_purchase_detail_id_ordinal_key")
  @@index([paymentId], map: "tickets_payment_id_idx")
  @@map("tickets")
  @@schema("tickets_app")
}

model TipoTicket {
  id                       String     @id(map: "ticket_types_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String     @map("event_id") @db.Uuid
  name                     String     @db.Text
  description              String?    @db.Text
  priceCents               BigInt     @map("price_cents") @default(0) @db.BigInt
  currency                 String     @default("MXN") @db.Text
  quantityTotal            Int        @map("quantity_total") @db.Integer
  maxPerOrder              Int        @map("max_per_order") @default(4) @db.Integer
  salesStartsAt            DateTime?  @map("sales_starts_at") @db.Timestamptz(6)
  salesEndsAt              DateTime?  @map("sales_ends_at") @db.Timestamptz(6)
  status                   String     @default("active") @db.Text
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  maxPerUser               Int        @map("max_per_user") @default(4) @db.Integer
  refEventId               Evento @relation("rel_ticket_types_event_id_fkey", fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromCompraDetalleTicketTypeIdEventId CompraDetalle[] @relation("rel_compra_detalles_ticket_type_id_event_id_fkey")
  fromInventarioTicketTypeId Inventario? @relation("rel_inventarios_ticket_type_id_fkey")
  fromReservaDetalleTicketTypeIdEventId ReservaDetalle[] @relation("rel_reserva_detalles_ticket_type_id_event_id_fkey")
  @@unique([eventId, name], map: "ticket_types_event_id_name_key")
  @@unique([id, eventId], map: "tipos_ticket_id_event_id_key")
  @@index([eventId], map: "ticket_types_event_id_idx")
  @@map("tipos_ticket")
  @@schema("tickets_app")
}

model Ubicacion {
  id                       String     @id(map: "venues_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String     @db.Text
  addressLine1             String?    @map("address_line1") @db.Text
  addressLine2             String?    @map("address_line2") @db.Text
  city                     String?    @db.Text
  region                   String?    @db.Text
  countryCode              String?    @map("country_code") @db.Text
  postalCode               String?    @map("postal_code") @db.Text
  latitude                 Decimal?   @db.Decimal(9, 6)
  longitude                Decimal?   @db.Decimal(9, 6)
  timezone                 String?    @db.Text
  capacity                 Int?       @db.Integer
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  fromEventoVenueId        Evento[] @relation("rel_events_venue_id_fkey")
