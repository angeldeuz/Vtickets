  @@index([eventId], map: "event_staff_event_id_idx")
  @@index([roleId], map: "event_staff_role_id_idx")
  @@index([userId], map: "event_staff_user_id_idx")
  @@index([userId, status], map: "personal_eventos_user_id_status_idx")
  @@map("personal_eventos")
  @@schema("tickets_app")
}

model Reembolso {
  id                       String     @id(map: "reembolsos_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId               String     @map("purchase_id") @db.Uuid
  paymentId                String     @map("payment_id") @db.Uuid
  ticketId                 String?    @map("ticket_id") @db.Uuid
  idempotencyKey           String     @map("idempotency_key") @db.Text
  reason                   String?    @db.Text
  reviewedBy               String?    @map("reviewed_by") @db.Uuid
  reviewedAt               DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  status                   String     @default("requested") @db.Text
  amountCents              BigInt     @map("amount_cents") @db.BigInt
  providerRefundId         String?    @map("provider_refund_id") @db.Text
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  refPaymentIdPurchaseId   Pago @relation("rel_reembolsos_payment_id_purchase_id_fkey", fields: [paymentId, purchaseId], references: [id, purchaseId], onDelete: Restrict, onUpdate: NoAction)
  refPurchaseId            Compra @relation("rel_reembolsos_purchase_id_fkey", fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refTicketIdPurchaseId    Ticket? @relation("rel_reembolsos_ticket_id_purchase_id_fkey", fields: [ticketId, purchaseId], references: [id, purchaseId], onDelete: Restrict, onUpdate: NoAction)
  refReviewedBy            Usuario? @relation("rel_reembolsos_reviewed_by_fkey", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([paymentId, idempotencyKey], map: "reembolsos_payment_idempotency_key_key")
  @@unique([ticketId, purchaseId], map: "reembolsos_ticket_id_purchase_id_key")
  @@index([purchaseId, createdAt(sort: Desc)], map: "reembolsos_purchase_created_idx")
  @@index([paymentId, purchaseId], map: "reembolsos_payment_purchase_idx")
  @@map("reembolsos")
  @@schema("tickets_app")
}

model ReservaDetalle {
  id                       String     @id(map: "reserva_detalles_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId            String     @map("reservation_id") @db.Uuid
  eventId                  String     @map("event_id") @db.Uuid
  ticketTypeId             String     @map("ticket_type_id") @db.Uuid
  quantity                 Int        @db.Integer
