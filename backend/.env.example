# La API arranca sin estos valores para permitir validar /api/v1/health.
# Las rutas de identidad necesitan la URL de Auth y una cuenta PostgreSQL de privilegios mínimos.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
SUPABASE_URL=
DATABASE_URL=
DB_POOL_MAX=5
# Para producción, el URL debe usar sslmode=verify-full y sslrootcert con el CA descargado del panel Supabase.
