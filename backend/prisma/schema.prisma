model Reserva {
  id                       String     @id(map: "reservas_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId               String     @map("customer_id") @db.Uuid
  eventId                  String     @map("event_id") @db.Uuid
  status                   String     @default("active") @db.Text
  expiresAt                DateTime   @map("expires_at") @db.Timestamptz(6)
  totalCents               BigInt     @map("total_cents") @default(0) @db.BigInt
  currency                 String     @default("MXN") @db.Text
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  refCustomerId            Usuario @relation("rel_reservas_customer_id_fkey", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refEventId               Evento @relation("rel_reservas_event_id_fkey", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fromCompraReservationIdEventIdCustomerId Compra[] @relation("rel_compras_reservation_id_event_id_customer_id_fkey")
