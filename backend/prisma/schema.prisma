  @@unique([id, eventId, customerId], map: "reservas_id_event_id_customer_id_key")
  @@unique([id, eventId], map: "reservas_id_event_id_key")
  @@index([customerId, status, createdAt(sort: Desc)], map: "reservas_customer_status_idx")
  @@index([eventId, status, expiresAt], map: "reservas_event_status_expiration_idx")
  @@map("reservas")
  @@schema("tickets_app")
}

model Rol {
  id                       String     @id(map: "roles_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String     @db.Text
  name                     String     @db.Text
