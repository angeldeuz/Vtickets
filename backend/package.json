{
  "name": "@vtickets/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:verify-f02": "node scripts/verify-f02-schema.mjs",
    "db:verify-runtime": "node scripts/verify-runtime.mjs",
    "db:inspect-f02": "node scripts/verify-f02-schema.mjs --inspect"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.9.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
