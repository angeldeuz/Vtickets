# Sin API, la web usa eventos de demostración claramente identificados.
# Al configurar la API, solo se muestran los eventos que esta devuelve.
VTICKETS_API_URL=

# Clave pública del proyecto de desarrollo: nunca usar service_role en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
