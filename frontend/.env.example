# URL interna de NestJS. Si se omite, se usa http://127.0.0.1:3001/api/v1.
# Sin respuesta de la API, la web muestra un estado de error.
VTICKETS_API_URL=

# Clave pública del proyecto de desarrollo: nunca usar service_role en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
