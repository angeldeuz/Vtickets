model UsuarioRol {
  userId                   String     @map("user_id") @db.Uuid
  roleId                   String     @map("role_id") @db.Uuid
  assignedBy               String?    @map("assigned_by") @db.Uuid
  assignedAt               DateTime   @map("assigned_at") @default(now()) @db.Timestamptz(6)
  refRoleId                Rol @relation("rel_user_roles_role_id_fkey", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refAssignedBy            Usuario? @relation("rel_usuario_roles_assigned_by_fkey", fields: [assignedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  refUserId                Usuario @relation("rel_usuario_roles_user_id_fkey", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId], map: "usuario_roles_role_id_idx")
  @@map("usuario_roles")
  @@schema("tickets_app")
}

model Usuario {
  // FK a auth.users(id): Auth la administra Supabase, no Prisma Migrate.
  authUserId               String?    @map("auth_user_id") @db.Uuid
  fullName                 String?    @map("full_name") @db.Text
  phone                    String?    @db.Text
  avatarUrl                String?    @map("avatar_url") @db.Text
  status                   String     @default("active") @db.Text
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime   @map("updated_at") @default(now()) @db.Timestamptz(6)
  id                       String     @id(map: "usuarios_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anonymizedAt             DateTime?  @map("anonymized_at") @db.Timestamptz(6)
  fromAccesoScannedBy      Acceso[] @relation("rel_accesos_scanned_by_fkey")
  fromAuditoriaActorUserId Auditoria[] @relation("rel_auditoria_actor_user_id_fkey")
  fromCompraCustomerId     Compra[] @relation("rel_compras_customer_id_fkey")
  fromEventoOrganizerId    Evento[] @relation("rel_eventos_organizer_id_fkey")
  fromHistorialEscaneoScannedBy HistorialEscaneo[] @relation("rel_historial_escaneos_scanned_by_fkey")
  fromIdempotenciaSolicitudUserId IdempotenciaSolicitud[] @relation("rel_idempotencia_solicitudes_user_id_fkey")
  fromNotificacionUserId   Notificacion[] @relation("rel_notificaciones_user_id_fkey")
  fromPersonalEventoAssignedBy PersonalEvento[] @relation("rel_personal_eventos_assigned_by_fkey")
  fromPersonalEventoUserId PersonalEvento[] @relation("rel_personal_eventos_user_id_fkey")
  fromReservaCustomerId    Reserva[] @relation("rel_reservas_customer_id_fkey")
  fromReembolsoReviewedBy  Reembolso[] @relation("rel_reembolsos_reviewed_by_fkey")
  fromUsuarioRolAssignedBy UsuarioRol[] @relation("rel_usuario_roles_assigned_by_fkey")
  fromUsuarioRolUserId     UsuarioRol[] @relation("rel_usuario_roles_user_id_fkey")
  @@unique([authUserId], map: "usuarios_auth_user_id_key")
  @@map("usuarios")
  @@schema("tickets_app")
}

model WebhookEvento {
  id                       String     @id(map: "webhook_eventos_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                 String     @db.Text
  externalEventId          String     @map("external_event_id") @db.Text
  payloadSha256            String     @map("payload_sha256") @db.Text
  safePayload              Json?      @map("safe_payload") @db.JsonB
  status                   String     @default("received") @db.Text
  attempts                 Int        @default(0) @db.Integer
  nextAttemptAt            DateTime   @map("next_attempt_at") @default(now()) @db.Timestamptz(6)
  processedAt              DateTime?  @map("processed_at") @db.Timestamptz(6)
  lastError                String?    @map("last_error") @db.Text
  createdAt                DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  paymentId                String?    @map("payment_id") @db.Uuid
  refPaymentId             Pago? @relation("rel_webhook_eventos_payment_id_fkey", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([provider, externalEventId], map: "webhook_eventos_provider_external_event_id_key")
  @@map("webhook_eventos")
  @@schema("tickets_app")
}
