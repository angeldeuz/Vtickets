-- Ejecutar solo tras crear la identidad en Supabase Auth y aplicar la línea
-- base, la migración F02 y database/seeds/roles.sql en un entorno controlado.
-- Uso futuro: psql ... -v auth_user_id=<uuid> -f database/scripts/bootstrap_admin.psql
-- Requiere una conexión administrativa; no usar credenciales de la aplicación.
\set ON_ERROR_STOP on

BEGIN;

-- La FK a auth.users rechaza cualquier identificador que Auth no conozca.
WITH perfil AS (
  INSERT INTO tickets_app.usuarios (auth_user_id)
  VALUES (:'auth_user_id'::uuid)
  ON CONFLICT (auth_user_id)
  DO UPDATE SET auth_user_id = EXCLUDED.auth_user_id
  RETURNING id, status
), asignacion AS (
  INSERT INTO tickets_app.usuario_roles (user_id, role_id)
  SELECT perfil.id, rol.id
  FROM perfil
  CROSS JOIN tickets_app.roles AS rol
  WHERE rol.code = 'ADMINISTRADOR' AND perfil.status = 'active'
  ON CONFLICT (user_id, role_id) DO NOTHING
  RETURNING user_id
)
INSERT INTO tickets_app.auditoria
  (actor_user_id, action, entity_name, entity_id, metadata)
SELECT NULL, 'bootstrap_admin', 'usuario_roles', user_id,
       jsonb_build_object('auth_user_id', :'auth_user_id'::uuid)
FROM asignacion;

COMMIT;

-- La consulta debe devolver una fila. Si no la devuelve, revisar que la
-- identidad exista en Auth, el rol ADMINISTRADOR esté sembrado y el perfil
-- esté activo. Nunca asignar el rol desde un formulario público.
SELECT u.id AS user_id, u.auth_user_id, u.status, r.code AS role_code
FROM tickets_app.usuarios AS u
JOIN tickets_app.usuario_roles AS ur ON ur.user_id = u.id
JOIN tickets_app.roles AS r ON r.id = ur.role_id
WHERE u.auth_user_id = :'auth_user_id'::uuid
  AND u.status = 'active'
  AND r.code = 'ADMINISTRADOR';
